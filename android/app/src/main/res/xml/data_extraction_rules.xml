<?xml version="1.0" encoding="utf-8"?>
<!--
  Task 9 — backup rules for Android 12+ (android:dataExtractionRules).
  Same semantics as res/xml/backup_rules.xml: Room databases + app files
  are backed up, except files/books/ + files/covers/ (re-importable, heavy).
  Cache dirs are never backed up, so no rule is needed for them.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="books/" />
        <exclude domain="file" path="covers/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="file" path="books/" />
        <exclude domain="file" path="covers/" />
    </device-transfer>
</data-extraction-rules>
