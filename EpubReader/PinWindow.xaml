<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EpubReader.PinWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="پین" Width="360" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" FlowDirection="RightToLeft" ResizeMode="NoResize" ShowInTaskbar="False" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
  <Border Name="DialogBorder" Background="{DynamicResource BgDark}" Margin="16" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14" MouseLeftButtonDown="Border_MouseLeftButtonDown">
    <UIElement.Effect>
      <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="24" ShadowDepth="4" Opacity="0.6" />
    </UIElement.Effect>
    <StackPanel Margin="28,24">
      <Border Width="52" Height="52" CornerRadius="26" Background="#33A78BFA" HorizontalAlignment="Center">
        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoLock}" Stroke="{DynamicResource AccentColor}" HorizontalAlignment="Center">
          <FrameworkElement.LayoutTransform>
            <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
          </FrameworkElement.LayoutTransform>
        </Path>
      </Border>
      <TextBlock Name="txtTitle" Text="پین رو وارد کنید" Foreground="{DynamicResource TextColor}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,4" />
      <TextBlock Name="txtSubtitle" Text="" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,18" TextWrapping="Wrap" TextAlignment="Center" />
      <TextBlock Name="lblPin" Text="پین" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4" />
      <PasswordBox Name="pinBox1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="10" FontSize="16" HorizontalContentAlignment="Center" MaxLength="8" Margin="0,0,0,12" />
      <TextBlock Name="lblConfirm" Text="تکرار پین" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,4" />
      <PasswordBox Name="pinBox2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="10" FontSize="16" HorizontalContentAlignment="Center" MaxLength="8" Margin="0,0,0,8" />
      <TextBlock Name="txtError" Text="" Foreground="#FF6B6B" FontSize="11" Margin="0,4,0,4" HorizontalAlignment="Center" Visibility="Collapsed" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
        <Button Name="btnOk" Content="تایید" Width="110" Margin="0,0,10,0" Style="{StaticResource ModernButton}" Click="btnOk_Click" />
        <Button Name="btnCancel" Content="انصراف" Width="110" Padding="16,10" Click="btnCancel_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>