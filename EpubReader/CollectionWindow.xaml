<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EpubReader.CollectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="مجموعه" Height="720" Width="1120" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource BgDark}" FlowDirection="RightToLeft" ResizeMode="CanResizeWithGrip">
  <Border Background="{DynamicResource BgDark}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Name="TitleBar" Grid.Row="0" Background="{DynamicResource BgSidebar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Name="btnBack" Grid.Column="0" Style="{StaticResource GhostButton}" Margin="6,4" Padding="12,4" Click="btnBack_Click">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource Ico}" Data="{StaticResource IcoArrowBack}" Margin="0,0,8,0" />
              <TextBlock Text="کتابخانه" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <TextBlock Grid.Column="1" Text="مجموعه" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0" FontSize="12" />
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Name="btnMinimize" Style="{StaticResource TitleBarButton}" Click="btnMinimize_Click">
              <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMinimize}" StrokeThickness="1.2" />
            </Button>
            <Button Name="btnMaximize" Style="{StaticResource TitleBarButton}" ToolTip="بزرگ‌نمایی" Click="btnMaximize_Click">
              <Path Name="icoMaximize" Style="{StaticResource Ico}" Data="{StaticResource IcoMaximize}" StrokeThickness="1.2" />
            </Button>
            <Button Name="btnClose" Style="{StaticResource TitleBarCloseButton}" Click="btnClose_Click">
              <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}" StrokeThickness="1.2" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Row="1" Height="230" ClipToBounds="True">
        <Image Name="imgHeroBackdrop" Stretch="UniformToFill" Opacity="0.35" Margin="-40">
          <UIElement.Effect>
            <BlurEffect Radius="45" />
          </UIElement.Effect>
        </Image>
        <Border>
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#6613111C" Offset="0" />
              <GradientStop Color="#FF13111C" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <DockPanel Margin="32,24,32,20">
          <Border DockPanel.Dock="Right" Width="124" Height="180" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource HoverColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <UIElement.Effect>
              <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="24" ShadowDepth="6" Opacity="0.6" />
            </UIElement.Effect>
            <Grid>
              <Path Data="{StaticResource IcoStack}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.2" Width="16" Height="16" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <FrameworkElement.LayoutTransform>
                  <ScaleTransform ScaleX="3" ScaleY="3" />
                </FrameworkElement.LayoutTransform>
              </Path>
              <Image Name="imgHeroCover" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <StackPanel Margin="28,0,0,0" VerticalAlignment="Bottom">
            <Border Background="#33A78BFA" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left">
              <TextBlock Text="مجموعه" Foreground="{DynamicResource AccentColor}" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <TextBlock Name="txtCollectionTitle" Text="مجموعه" Foreground="{DynamicResource TextColor}" FontSize="30" FontWeight="Bold" Margin="0,8,0,6" TextTrimming="CharacterEllipsis" />
            <TextBlock Name="txtCollectionStats" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12" />
            <Grid Margin="0,12,0,14" Width="320" HorizontalAlignment="Left">
              <ProgressBar Name="progressCollection" Style="{StaticResource ThinProgress}" Height="6" />
            </Grid>
            <StackPanel Orientation="Horizontal">
              <Button Name="btnContinue" Style="{StaticResource ModernButton}" Margin="0,0,10,0" Click="btnContinue_Click">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IcoFill}" Data="{StaticResource IcoPlay}" Width="16" Height="16" />
                  <TextBlock Text="ادامه مطالعه" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Name="btnRename" Padding="16,10" Click="btnRename_Click">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource Ico}" Data="{StaticResource IcoEdit}" />
                  <TextBlock Text="تغییر نام" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Grid>
      <DockPanel Grid.Row="2" Margin="32,8,32,4">
        <TextBlock Text="جلدها" Foreground="{DynamicResource TextColor}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Name="txtCount" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
      </DockPanel>
      <ScrollViewer Grid.Row="3" Style="{StaticResource ModernScrollViewer}" Margin="32,8,16,16">
        <Grid>
          <TextBlock Name="txtEmpty" Text="این مجموعه خالیه" Foreground="{DynamicResource TextMuted}" FontSize="14" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed" />
          <ItemsControl Name="listBoxBooks">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource BookCard}" Width="160" Margin="0,8,18,18" Tag="{Binding}" MouseLeftButtonUp="BookCard_MouseLeftButtonUp">
                  <Grid>
                    <StackPanel>
                      <Border CornerRadius="11,11,0,0" ClipToBounds="True" Height="210">
                        <Grid>
                          <Rectangle Fill="{DynamicResource AccentSoft}" />
                          <Path Data="{StaticResource IcoReading}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.2" Width="16" Height="16" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FrameworkElement.LayoutTransform>
                              <ScaleTransform ScaleX="2.6" ScaleY="2.6" />
                            </FrameworkElement.LayoutTransform>
                          </Path>
                          <Image Stretch="UniformToFill" Source="{Binding Book.CoverImagePath}" />
                          <Border Background="{DynamicResource AccentColor}" CornerRadius="0,0,0,10" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4">
                            <TextBlock Foreground="{DynamicResource OnAccent}" FontSize="11" FontWeight="Bold" Text="{Binding VolumeText}" />
                          </Border>
                        </Grid>
                      </Border>
                      <StackPanel Margin="12,10,12,12">
                        <TextBlock Foreground="{DynamicResource TextColor}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis" Text="{Binding Book.DisplayTitle}" />
                        <Grid Margin="0,6,0,8">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Grid.Column="0" Foreground="{DynamicResource TextMuted}" FontSize="11" Text="{Binding ProgressText}" />
                          <TextBlock Grid.Column="1" Foreground="{DynamicResource TextMuted}" FontSize="11" Text="{Binding PercentText}" />
                        </Grid>
                        <ProgressBar Style="{StaticResource CompletableProgress}" Value="{Binding Book.ProgressPercent, Mode=OneWay}" />
                      </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource CardIconButton}" Background="#F2FFFFFF" Foreground="#4C4766" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Tag="{Binding}" Click="BtnMore_Click">
                      <Path Style="{StaticResource IcoFill}" Data="{StaticResource IcoDots}" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>