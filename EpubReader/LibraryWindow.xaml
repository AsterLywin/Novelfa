<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EpubReader.LibraryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="کتابخانه من" Height="760" Width="1240" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource BgDark}" FlowDirection="RightToLeft" ResizeMode="CanResizeWithGrip" AllowDrop="True" PreviewDragEnter="Window_PreviewDragOver" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="ListPanelTemplate">
            <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="BookRowTemplate">
            <Grid Margin="0,0,0,10" Opacity="0" Loaded="CardRoot_Loaded">
                <Border Style="{StaticResource RowCard}" Tag="{Binding}" MouseLeftButtonUp="Card_MouseLeftButtonUp" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="56" Height="80" CornerRadius="9" ClipToBounds="True" Background="{DynamicResource AccentSoft}">
                            <Image Stretch="UniformToFill" Source="{Binding CoverImage}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TextColor}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                            <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Text="{Binding ProgressText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                            <DockPanel Margin="0,0,0,8">
                                <Border DockPanel.Dock="Right" CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,2,8,3">
                                    <TextBlock Foreground="{DynamicResource AccentColor}" FontSize="11" FontWeight="SemiBold" Text="{Binding PercentText}" />
                                </Border>
                                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="11" Text="{Binding SubtitleText}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ProgressBar Style="{StaticResource CompletableProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" Height="5" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Style="{StaticResource IcoFill}" Data="{StaticResource IcoHeart}" Fill="{DynamicResource AccentColor}" Margin="0,0,12,0" Visibility="{Binding FavoriteVisibility}" />
                            <Button Style="{StaticResource CardIconButton}" Background="{DynamicResource HoverColor}" Foreground="{DynamicResource TextColor}" Tag="{Binding}" Click="BtnMore_Click">
                                <Path Style="{StaticResource IcoFill}" Data="{StaticResource IcoDots}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Name="rootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Name="sidebarPanel" Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Path Data="{DynamicResource ThemeEmblem}" Fill="{DynamicResource AccentGradient}" Stretch="Uniform" Width="230" Height="230" Opacity="0.07" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False" Visibility="{DynamicResource ThemeArtVisibility}">
                    <UIElement.CacheMode>
                        <BitmapCache />
                    </UIElement.CacheMode>
                </Path>
                <DockPanel Margin="16,20,16,16">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,28">
                        <Image Source="Assets/AppLogo.png" Width="44" Height="44" VerticalAlignment="Center" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="کتابخانه" Foreground="{DynamicResource TextColor}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <Border Name="profileCard" DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="10" CornerRadius="16" BorderThickness="1" Cursor="Hand" ToolTip="تغییر اسم" MouseLeftButtonDown="Profile_MouseLeftButtonDown" MouseLeftButtonUp="Profile_MouseLeftButtonUp">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource BgCard}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Name="avatarHost" Width="72" Height="72" VerticalAlignment="Center" Cursor="Hand" Background="#00FFFFFF" MouseLeftButtonDown="Avatar_MouseLeftButtonDown" MouseLeftButtonUp="Avatar_MouseLeftButtonUp" MouseRightButtonUp="Avatar_MouseRightButtonUp" MouseEnter="Avatar_MouseEnter" MouseLeave="Avatar_MouseLeave">
                                <Ellipse Name="ringTrack" Stroke="{DynamicResource BorderColor}" StrokeThickness="3" />
                                <Ellipse Name="ringProgress" Stroke="{DynamicResource AccentColor}" StrokeThickness="3" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Border Margin="5" CornerRadius="31" Background="{DynamicResource BgDark}" />
                                <Border Name="avatarFrame" Margin="5" CornerRadius="31" RenderOptions.BitmapScalingMode="HighQuality" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" SnapsToDevicePixels="True" />
                                <Border Name="avatarOverlay" Margin="5" CornerRadius="31" Background="#55000000" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Path Style="{StaticResource Ico}" Data="M2,5 H4.5 L5.8,3 H10.2 L11.5,5 H14 V13 H2 Z M8,7.2 A2.2,2.2 0 1 1 7.99,7.2 Z" Stroke="#FFFFFFFF" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Name="txtProfileName" Text="کتابخوان من" Foreground="{DynamicResource TextColor}" FontSize="13" FontWeight="Bold" MaxWidth="104" TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,4,0,0" HorizontalAlignment="Left">
                                    <Border CornerRadius="8" Background="{DynamicResource AccentColor}" Opacity="0.18" />
                                    <TextBlock Name="txtRank" Text="تازه‌وارد" Foreground="{DynamicResource AccentColor}" FontSize="10" FontWeight="SemiBold" Margin="8,2,8,3" />
                                </Grid>
                                <TextBlock Name="txtProfileCount" Text="0 کتاب" Foreground="{DynamicResource TextMuted}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="104" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="کتاب‌ها" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,8" />
                        <Button Name="btnTabAll" Tag="all" Style="{StaticResource NavButton}" Click="TabButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAll}" />
                                <TextBlock Text="همه کتاب‌ها" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="btnTabFav" Tag="favorites" Style="{StaticResource NavButton}" Click="TabButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoHeart}" />
                                <TextBlock Text="علاقه‌مندی‌ها" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="btnTabReading" Tag="reading" Style="{StaticResource NavButton}" Click="TabButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoReading}" />
                                <TextBlock Text="در حال مطالعه" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="btnTabCompleted" Tag="completed" Style="{StaticResource NavButton}" Click="TabButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoCheckCircle}" />
                                <TextBlock Text="تمام‌شده" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="btnTabRecent" Tag="recent" Style="{StaticResource NavButton}" Click="TabButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClock}" />
                                <TextBlock Text="اخیراً بازشده" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="حریم خصوصی" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="8,24,0,8" />
                        <Button Name="btnTabPrivate" Tag="private" Style="{StaticResource NavButton}" Click="TabButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoLock}" />
                                <TextBlock Text="خصوصی" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="btnChangePin" Style="{StaticResource NavButton}" Click="btnChangePin_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoKey}" />
                                <TextBlock Text="تغییر رمز" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="شخصی‌سازی" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="8,24,0,8" />
                        <Button Name="btnShortcuts" Style="{StaticResource NavButton}" Click="btnShortcuts_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoEdit}" />
                                <TextBlock Text="کلیدهای میانبر" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="btnAccent" Style="{StaticResource NavButton}" Click="btnAccent_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoDrop}" />
                                <TextBlock Text="رنگ برنامه" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="btnThemes" Style="{StaticResource NavButton}" Click="btnThemes_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="M8,1.5 L9.8,6.2 L14.5,8 L9.8,9.8 L8,14.5 L6.2,9.8 L1.5,8 L6.2,6.2 Z" />
                                <TextBlock Text="تم‌های های خاص" Margin="12,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Name="txtThemeCount" Text="" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" />
                            </StackPanel>
                        </Button>
                        <Button Name="btnAbout" Style="{StaticResource NavButton}" Click="btnAbout_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource Ico}" Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M8,7 V11.5 M8,4.6 V4.8" />
                                <TextBlock Text="درباره ما" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
        <Border Grid.Column="1" IsHitTestVisible="False" Background="{DynamicResource ThemeAuraA}" />
        <Border Grid.Column="1" IsHitTestVisible="False" Background="{DynamicResource ThemeAuraB}" />
        <Path Grid.Column="1" Data="{DynamicResource ThemeEmblem}" Fill="{DynamicResource AccentGradient}" Stretch="Uniform" Width="420" Height="420" Opacity="0.06" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-70,0,-60,-80" IsHitTestVisible="False" Visibility="{DynamicResource ThemeArtVisibility}">
            <UIElement.CacheMode>
                <BitmapCache />
            </UIElement.CacheMode>
        </Path>
        <Grid Name="contentPanel" Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnLanguage" Style="{StaticResource TitleBarButton}" Width="64" Height="36" ToolTip="زبان" Click="btnLanguage_Click">
                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                            <Path Style="{StaticResource Ico}" Data="M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M1.5,8 H14.5 M8,1.5 C5.2,4.2 5.2,11.8 8,14.5 M8,1.5 C10.8,4.2 10.8,11.8 8,14.5" StrokeThickness="1.2" />
                            <TextBlock x:Name="txtLanguage" Text="FA" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnTheme" Style="{StaticResource TitleBarButton}" Height="36" ToolTip="تغییر حالت روشن/تیره" Click="btnTheme_Click">
                        <Path x:Name="icoTheme" Style="{StaticResource Ico}" Data="{StaticResource IcoMoon}" />
                    </Button>
                    <Button x:Name="btnMinimize" Style="{StaticResource TitleBarButton}" Height="36" Click="btnMinimize_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoMinimize}" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="btnMaximize" Style="{StaticResource TitleBarButton}" Height="36" ToolTip="بزرگ‌نمایی" Click="btnMaximize_Click">
                        <Path x:Name="icoMaximize" Style="{StaticResource Ico}" Data="{StaticResource IcoMaximize}" StrokeThickness="1.2" />
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource TitleBarCloseButton}" Height="36" Click="btnClose_Click">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}" StrokeThickness="1.2" />
                    </Button>
                </StackPanel>
            </Border>
            <DockPanel Grid.Row="1" Margin="36,4,36,20">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Name="txtGreeting" Text="صبح بخیر" Foreground="{DynamicResource TextColor}" FontSize="26" FontWeight="Bold" />
                    <TextBlock Name="txtGreetingSub" Text="امروز چی می‌خونی؟" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="12" Width="290" Height="44" BorderThickness="1" Margin="0,0,12,0">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Background" Value="{DynamicResource BgCard}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorDark}" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True" />
                                            <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                        </MultiTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSearch}" Stroke="{DynamicResource TextMuted}" HorizontalAlignment="Left" Margin="14,0,0,0" />
                            <TextBox Name="txtSearch" Background="#00FFFFFF" BorderThickness="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="38,0,12,0" FontSize="13" TextChanged="txtSearch_TextChanged" />
                            <TextBlock Text="جستجوی کتاب..." Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="42,0,0,0" IsHitTestVisible="False" FontSize="13">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Value="" Binding="{Binding Text, ElementName=txtSearch}">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Button Name="btnAddBook" Style="{StaticResource ModernButton}" Height="44" Padding="18,0" Click="btnAddBook_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoPlus}" StrokeThickness="2" />
                            <TextBlock Text="افزودن کتاب" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="2" Style="{StaticResource ModernScrollViewer}" Margin="0,0,8,8">
                <StackPanel Margin="36,0,28,24">
                    <Grid Name="statsStrip" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Tag="all" Cursor="Hand" CornerRadius="16" BorderThickness="1" Padding="16,14" Margin="0,0,14,0" MouseLeftButtonUp="Stat_Click">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource BgCard}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoAll}" Stroke="{DynamicResource AccentColor}" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Name="txtStatTotal" Text="0" Foreground="{DynamicResource TextColor}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="کل کتاب‌ها" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Tag="reading" Cursor="Hand" CornerRadius="16" BorderThickness="1" Padding="16,14" Margin="0,0,14,0" MouseLeftButtonUp="Stat_Click">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource BgCard}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoReading}" Stroke="{DynamicResource AccentColor}" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Name="txtStatReading" Text="0" Foreground="{DynamicResource TextColor}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="در حال مطالعه" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="2" Tag="completed" Cursor="Hand" CornerRadius="16" BorderThickness="1" Padding="16,14" Margin="0,0,14,0" MouseLeftButtonUp="Stat_Click">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource BgCard}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoCheckCircle}" Stroke="{DynamicResource AccentColor}" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Name="txtStatDone" Text="0" Foreground="{DynamicResource TextColor}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="تمام‌شده" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="3" Tag="favorites" Cursor="Hand" CornerRadius="16" BorderThickness="1" Padding="16,14" Margin="0" MouseLeftButtonUp="Stat_Click">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource BgCard}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                            <Setter Property="Background" Value="{DynamicResource HoverColor}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Ico}" Data="{StaticResource IcoHeart}" Stroke="{DynamicResource AccentColor}" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Name="txtStatFav" Text="0" Foreground="{DynamicResource TextColor}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="علاقه‌مندی" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <Border Name="heroCard" Background="{DynamicResource HeroGradient}" CornerRadius="20" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="0" Margin="0,0,0,32" Visibility="Collapsed">
                        <UIElement.Effect>
                            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="30" ShadowDepth="6" Opacity="0.45" RenderingBias="Performance" />
                        </UIElement.Effect>
                        <Grid>
                            <Border Background="{DynamicResource AccentColor}" Opacity="0.32" IsHitTestVisible="False" CornerRadius="19">
                                <Border.OpacityMask>
                                    <RadialGradientBrush Center="0.12,0.1" GradientOrigin="0.12,0.1" RadiusX="0.75" RadiusY="1.1">
                                        <GradientStop Color="#FF000000" Offset="0" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Path Data="{DynamicResource ThemeEmblem}" Fill="{DynamicResource AccentGradient}" Stretch="Uniform" Width="190" Height="190" Opacity="0.14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="26,0,0,0" IsHitTestVisible="False" Visibility="{DynamicResource ThemeArtVisibility}">
                                <UIElement.CacheMode>
                                    <BitmapCache />
                                </UIElement.CacheMode>
                            </Path>
                            <DockPanel HorizontalAlignment="Center" Margin="36,30">
                                <Grid DockPanel.Dock="Right" Width="200" Height="220" Margin="24,0,0,0">
                                    <Border Width="128" Height="184" CornerRadius="12" Background="{DynamicResource AccentGradient}" RenderTransformOrigin="0.5,0.5" Margin="0,0,40,0" Opacity="0.85">
                                        <UIElement.RenderTransform>
                                            <RotateTransform Angle="-10" />
                                        </UIElement.RenderTransform>
                                    </Border>
                                    <Border Width="128" Height="184" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource HoverColor}" RenderTransformOrigin="0.5,0.5">
                                        <UIElement.RenderTransform>
                                            <RotateTransform Angle="4" />
                                        </UIElement.RenderTransform>
                                        <UIElement.Effect>
                                            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="6" Opacity="0.6" RenderingBias="Performance" />
                                        </UIElement.Effect>
                                        <Image Name="imgHeroCover" Stretch="UniformToFill" />
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" MinWidth="420" MaxWidth="560">
                                    <TextBlock Text="ادامه مطالعه" Foreground="{DynamicResource AccentColor}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Name="txtHeroTitle" Text="" Foreground="{DynamicResource TextColor}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="120" TextTrimming="CharacterEllipsis" Margin="0,10,0,8" />
                                    <TextBlock Name="txtHeroChapter" Text="" Foreground="{DynamicResource TextMuted}" FontSize="13" />
                                    <DockPanel Margin="0,22,0,6">
                                        <TextBlock Text="پیشرفت" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                        <TextBlock Name="txtHeroPercent" Text="0٪" Foreground="{DynamicResource TextColor}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <ProgressBar Name="progressHero" Style="{StaticResource ThinProgress}" Height="6" Foreground="{DynamicResource AccentColor}" />
                                    <Button Name="btnHeroContinue" Style="{StaticResource LightButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="btnHeroContinue_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ادامه خواندن" VerticalAlignment="Center" />
                                            <Path Style="{StaticResource Ico}" Data="{StaticResource IcoArrowForward}" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox Name="cmbSort" Width="190" Height="36" FontSize="12" Margin="0,0,10,0" SelectionChanged="cmbSort_SelectionChanged">
                                <ComboBoxItem Content="مرتب‌سازی: پیش‌فرض" IsSelected="True" />
                                <ComboBoxItem Content="تازه‌ترین اضافه‌شده" />
                                <ComboBoxItem Content="آخرین مطالعه" />
                                <ComboBoxItem Content="نام (الف تا ی)" />
                                <ComboBoxItem Content="بیشترین پیشرفت" />
                            </ComboBox>
                            <Border CornerRadius="10" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Name="btnViewGrid" Style="{StaticResource ViewToggleButton}" ToolTip="نمای شبکه‌ای" Click="btnViewGrid_Click">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoGrid}" />
                                    </Button>
                                    <Button Name="btnViewList" Style="{StaticResource ViewToggleButton}" ToolTip="نمای لیستی" Click="btnViewList_Click">
                                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoList}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Border Width="4" Height="20" CornerRadius="2" Background="{DynamicResource AccentColor}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Name="txtSectionTitle" Text="کتاب‌های من" Foreground="{DynamicResource TextColor}" FontSize="19" FontWeight="Bold" />
                        <TextBlock Name="txtSectionCount" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="10,2,0,0" />
                    </DockPanel>
                    <TextBlock Name="txtEmpty" Text="اینجا هنوز کتابی نیست&#10;فایل‌های EPUB رو بکش و اینجا رها کن" TextAlignment="Center" LineHeight="26" Foreground="{DynamicResource TextMuted}" FontSize="14" HorizontalAlignment="Center" Margin="0,60,0,0" Visibility="Collapsed" />
                    <ItemsControl Name="listBoxBooks">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Name="CardRoot" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0,10,20,20" Opacity="0" Loaded="CardRoot_Loaded">
                                    <Border Background="{DynamicResource BorderColor}" CornerRadius="16" Margin="14,-10,14,10" Opacity="0.6" Visibility="{Binding CollectionBadgeVisibility}" />
                                    <Border Background="{DynamicResource HoverColor}" CornerRadius="16" Margin="7,-5,7,5" Visibility="{Binding CollectionBadgeVisibility}" />
                                    <Border Style="{StaticResource BookCard}" CornerRadius="16" Tag="{Binding}" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                        <Grid>
                                            <StackPanel>
                                                <Border CornerRadius="15,15,0,0" ClipToBounds="True" Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Background="{DynamicResource AccentSoft}">
                                                    <Grid>
                                                        <Path Data="{StaticResource IcoReading}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.2" Width="16" Height="16" Stretch="None" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <FrameworkElement.LayoutTransform>
                                                                <ScaleTransform ScaleX="2.6" ScaleY="2.6" />
                                                            </FrameworkElement.LayoutTransform>
                                                        </Path>
                                                        <Image Stretch="UniformToFill" Source="{Binding CoverImage}" RenderTransformOrigin="0.5,0.5">
                                                            <Image.RenderTransform>
                                                                <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1" />
                                                            </Image.RenderTransform>
                                                        </Image>
                                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource AccentColor}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Visibility="{Binding FavoriteVisibility}" IsHitTestVisible="False">
                                                            <Path Style="{StaticResource IcoFill}" Data="{StaticResource IcoHeart}" Fill="{DynamicResource OnAccent}" HorizontalAlignment="Center" />
                                                        </Border>
                                                        <Border Height="64" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#00000000" Offset="0" />
                                                                    <GradientStop Color="#B3000000" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                        <ProgressBar Style="{StaticResource CompletableProgress}" Value="{Binding ProgressPercent, Mode=OneWay}" Background="#55FFFFFF" Height="4" VerticalAlignment="Bottom" Margin="14,0,14,10" />
                                                        <Border Background="{DynamicResource AccentColor}" CornerRadius="8" HorizontalAlignment="Right" Margin="10,10,10,24" VerticalAlignment="Bottom" Padding="9,4" Visibility="{Binding CollectionBadgeVisibility}">
                                                            <TextBlock Foreground="{DynamicResource OnAccent}" FontSize="10" FontWeight="Bold" Text="{Binding SubtitleText}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="14,12,14,14">
                                                    <TextBlock Foreground="{DynamicResource TextColor}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Height="36" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" Text="{Binding ProgressText}" />
                                                        <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource AccentSoft}" Padding="8,2,8,3">
                                                            <TextBlock Foreground="{DynamicResource AccentColor}" FontSize="11" FontWeight="SemiBold" Text="{Binding PercentText}" />
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Name="MoreBtn" Opacity="0" Style="{StaticResource CardIconButton}" Background="#F2FFFFFF" Foreground="#4C4766" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Tag="{Binding}" Click="BtnMore_Click">
                                                <Path Style="{StaticResource IcoFill}" Data="{StaticResource IcoDots}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="MoreBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3" />
                                                    <DoubleAnimation Storyboard.TargetName="CoverScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3" />
                                                    <DoubleAnimation Storyboard.TargetName="MoreBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Name="dimOverlay" Grid.ColumnSpan="2" Background="#B30F0E17" Visibility="Collapsed" />
        <Grid Name="dropOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Background="{DynamicResource BgDark}" Opacity="0.93" />
            <Rectangle Margin="28" RadiusX="24" RadiusY="24" Stroke="{DynamicResource AccentColor}" StrokeThickness="2" StrokeDashArray="5 4" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="84" Height="84" CornerRadius="24" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IcoFile}" Stroke="{DynamicResource AccentColor}" StrokeThickness="1.2" Width="16" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path.LayoutTransform>
                            <ScaleTransform ScaleX="2.8" ScaleY="2.8" />
                        </Path.LayoutTransform>
                    </Path>
                </Border>
                <TextBlock Text="فایل‌های EPUB رو اینجا رها کن" Foreground="{DynamicResource TextColor}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                <TextBlock Text="می‌تونی چند کتاب یا یه پوشه رو هم‌زمان بندازی" Foreground="{DynamicResource TextMuted}" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
        <Border Name="busyBar" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Padding="22,14" CornerRadius="14" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="txtBusy" Foreground="{DynamicResource TextColor}" FontSize="13" VerticalAlignment="Center" />
                <ProgressBar Name="progressBusy" Style="{StaticResource ThinProgress}" Width="150" Height="5" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>