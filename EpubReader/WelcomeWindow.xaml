<Window x:Class="EpubReader.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="خوش آمدی" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="#00FFFFFF"
        FlowDirection="RightToLeft" ResizeMode="NoResize"
        ShowInTaskbar="False" Loaded="Window_Loaded">
    <Border Background="{DynamicResource BgDark}" Margin="16"
          BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="18">
        <UIElement.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="30" ShadowDepth="6" Opacity="0.6" />
        </UIElement.Effect>
        <Grid>
            <StackPanel Margin="32,30">
                <StackPanel Background="#00FFFFFF" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Image Source="Assets/AppLogo.png" Width="64" Height="64" HorizontalAlignment="Center" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Name="txtTitle" Text="اسمت چیه؟" Foreground="{DynamicResource TextColor}" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,6" />
                    <TextBlock Name="txtSubtitle" Text="قبل از شروع، یه اسم برای خودت انتخاب کن" Foreground="{DynamicResource TextMuted}" FontSize="12"
                   HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" />
                </StackPanel>

                <!-- حالت اول: گرفتن اسم -->
                <StackPanel Name="panelAsk">
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                CornerRadius="12" Height="46">
                        <Grid>
                            <TextBox Name="txtName" Background="#00FFFFFF" BorderThickness="0" FontSize="14"
                     VerticalContentAlignment="Center" Padding="14,0" KeyDown="txtName_KeyDown" TextChanged="txtName_TextChanged" />
                            <TextBlock Text="مثلاً: علی" Foreground="{DynamicResource TextMuted}" FontSize="14"
                       VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type TextBlock}">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Value="" Binding="{Binding Text, ElementName=txtName}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <TextBlock Name="txtError" Foreground="#FF6B6B" FontSize="11" Margin="4,8,0,0" Visibility="Collapsed" />
                    <Button Name="btnContinue" Content="ادامه" Style="{StaticResource ModernButton}"
                Height="44" Margin="0,22,0,0" Click="btnContinue_Click" />
                    <Button Name="btnCancel" Content="انصراف" Style="{StaticResource GhostButton}"
                Height="38" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>

                <!-- حالت دوم: پیام خوش‌آمد -->
                <StackPanel Name="panelWelcome" Visibility="Collapsed">
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="12" Padding="16,14">
                        <TextBlock Name="txtWelcomeName" Foreground="{DynamicResource AccentColor}" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Button Name="btnStart" Content="بزن بریم" Style="{StaticResource ModernButton}"
                Height="44" Margin="0,22,0,0" Click="btnStart_Click" />
                </StackPanel>
            </StackPanel>
            <!-- ضربدر: فقط در اولین اجرا، کل برنامه را می‌بندد -->
            <Button Name="btnClose" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,12,0,0"
              ToolTip="بستن برنامه" Visibility="Collapsed" Click="btnClose_Click">
                <Path Style="{StaticResource Ico}" Data="{StaticResource IcoClose}" StrokeThickness="1.2" />
            </Button>
        </Grid>
    </Border>
</Window>
